{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "penguins-posts",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEDIA_GROUP_DO",
        "class_name": "MediaGroupCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MediaGroupCoordinator"]
    }
  ]
}
